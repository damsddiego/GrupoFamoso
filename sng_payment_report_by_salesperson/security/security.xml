<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Regla global: filtra registros por compañías activas del usuario -->
        <record id="payment_report_salesperson_company_rule" model="ir.rule">
            <field name="name">Payment Report Salesperson: Multi-Company</field>
            <field name="model_id" ref="model_payment_report_salesperson"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
