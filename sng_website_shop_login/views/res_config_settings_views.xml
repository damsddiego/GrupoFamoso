<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_shop_login" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sng.shop.login</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="website_checkout_registration" position="after">
                <setting id="sng_shop_login_required_setting"
                         help="Los visitantes sin sesión no ven productos: la tienda redirige al login.">
                    <field name="sng_shop_login_required"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
