<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sng_return_confirm_wizard_form" model="ir.ui.view">
        <field name="name">sng.return.confirm.wizard.form</field>
        <field name="model">sng.return.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccionar almacén de devolución">
                <group>
                    <field name="return_id"/>
                    <field name="partner_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="warehouse_id"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="location_dest_id"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Confirmar y crear recepción"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
