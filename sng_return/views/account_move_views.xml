<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sng_return" model="ir.ui.view">
        <field name="name">account.move.form.sng.return</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//field[@name='invoice_origin']" position="after">
                <field name="sng_return_id"
                       readonly="1"
                       invisible="not sng_return_id"
                       groups="sng_return.group_sng_return_user"/>
                <field name="sng_return_warehouse_id"
                       readonly="1"
                       invisible="not sng_return_id"
                       groups="sng_return.group_sng_return_user"/>
                <field name="sng_return_location_id"
                       readonly="1"
                       invisible="not sng_return_id"
                       groups="sng_return.group_sng_return_user"/>
                <field name="sng_return_picking_id"
                       readonly="1"
                       invisible="not sng_return_picking_id"
                       groups="sng_return.group_sng_return_user"/>
            </xpath>
        </field>
    </record>
</odoo>
