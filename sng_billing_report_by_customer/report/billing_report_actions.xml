<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_billing_report_landscape" model="report.paperformat">
        <field name="name">Facturación por Cliente - A4 Horizontal</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">25</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">15</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_billing_report_pdf" model="ir.actions.report">
        <field name="name">Facturación por Cliente</field>
        <field name="model">sng.billing.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sng_billing_report_by_customer.billing_report_document</field>
        <field name="report_file">sng_billing_report_by_customer.billing_report_document</field>
        <field name="paperformat_id" ref="paperformat_billing_report_landscape"/>
        <field name="print_report_name">'Facturacion_por_cliente_%s_%s' % (object.date_from, object.date_to)</field>
        <field name="binding_type">report</field>
    </record>
</odoo>

