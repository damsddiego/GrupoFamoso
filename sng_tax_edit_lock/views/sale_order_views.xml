<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_sng_tax_edit_lock" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sng.tax.edit.lock</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Lista inline de lineas del pedido. -->
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="before">
                <field name="sng_tax_edit_allowed" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="attributes">
                <attribute name="readonly">not sng_tax_edit_allowed or qty_invoiced &gt; 0 or is_downpayment</attribute>
            </xpath>

            <!-- Formulario (dialogo) de linea del pedido. -->
            <xpath expr="//field[@name='order_line']/form//field[@name='tax_id']" position="before">
                <field name="sng_tax_edit_allowed" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='tax_id']" position="attributes">
                <attribute name="readonly">not sng_tax_edit_allowed or qty_invoiced &gt; 0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
