<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_sng_dashboard_gerencial" model="ir.actions.client">
        <field name="name">Dashboard Gerencial</field>
        <field name="tag">sng_dashboard_gerencial.dashboard</field>
    </record>

    <record id="view_sng_dashboard_analisis_list" model="ir.ui.view">
        <field name="name">sng.dashboard.analisis.list</field>
        <field name="model">sng.dashboard.analisis</field>
        <field name="arch" type="xml">
            <list string="Análisis IA" create="false" edit="false">
                <field name="fecha"/>
                <field name="company_id"/>
                <field name="tipo" widget="badge"/>
                <field name="salud" widget="badge"
                       decoration-success="salud == 'buena'"
                       decoration-warning="salud == 'regular'"
                       decoration-danger="salud == 'critica'"/>
                <field name="origen"/>
                <field name="resumen"/>
            </list>
        </field>
    </record>

    <record id="view_sng_dashboard_analisis_form" model="ir.ui.view">
        <field name="name">sng.dashboard.analisis.form</field>
        <field name="model">sng.dashboard.analisis</field>
        <field name="arch" type="xml">
            <form string="Análisis IA" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="tipo"/>
                        <field name="fecha"/>
                        <field name="salud"/>
                        <field name="origen"/>
                    </group>
                    <group string="Resumen ejecutivo">
                        <field name="resumen" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Detalle (JSON)">
                        <field name="contenido" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sng_dashboard_analisis" model="ir.actions.act_window">
        <field name="name">Historial de análisis IA</field>
        <field name="res_model">sng.dashboard.analisis</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sng_dashboard_root"
              name="Dashboard Gerencial"
              sequence="8"
              groups="sng_dashboard_gerencial.group_sng_dashboard_gerencial,sng_dashboard_gerencial.group_sng_dashboard_inventario,sng_dashboard_gerencial.group_sng_dashboard_estrategia"
              web_icon="sng_dashboard_gerencial,static/description/icon.png"/>
    <menuitem id="menu_sng_dashboard_principal"
              name="Dashboard"
              parent="menu_sng_dashboard_root"
              action="action_sng_dashboard_gerencial"
              sequence="10"/>
    <menuitem id="menu_sng_dashboard_analisis"
              name="Historial de análisis IA"
              parent="menu_sng_dashboard_root"
              action="action_sng_dashboard_analisis"
              sequence="20"/>

</odoo>
