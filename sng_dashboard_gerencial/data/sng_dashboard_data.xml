<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- La API key se reutiliza de sng_ruteros_pagos si ya está
             configurada; estos parámetros solo aplican como respaldo. -->
        <record id="config_anthropic_api_key" model="ir.config_parameter">
            <field name="key">sng_dashboard_gerencial.anthropic_api_key</field>
            <field name="value">PENDIENTE_CONFIGURAR</field>
        </record>

        <record id="config_anthropic_model" model="ir.config_parameter">
            <field name="key">sng_dashboard_gerencial.anthropic_model</field>
            <field name="value">claude-opus-4-8</field>
        </record>

        <!-- Cobertura objetivo (meses) del sugerido de compras en la
             pestaña Estrategia: stock deseado = venta mensual × cobertura -->
        <record id="config_cobertura_objetivo" model="ir.config_parameter">
            <field name="key">sng_dashboard_gerencial.cobertura_objetivo_meses</field>
            <field name="value">3</field>
        </record>

        <!-- Análisis IA semanal: lunes 12:00 UTC = 06:00 Costa Rica
             (una hora después de la morosidad de sng_ruteros_pagos) -->
        <record id="cron_sng_dashboard_analisis_ia" model="ir.cron">
            <field name="name">SNG Dashboard: análisis IA semanal</field>
            <field name="model_id" ref="model_sng_dashboard_analisis"/>
            <field name="state">code</field>
            <field name="code">model._sng_cron_analisis_ia()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=((7 - DateTime.now().weekday()) % 7) or 7)).strftime('%Y-%m-%d 12:00:00')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
