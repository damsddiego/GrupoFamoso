<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sng_commission_monthly_tree" model="ir.ui.view">
            <field name="name">sng.commission.monthly.tree</field>
            <field name="model">sng.commission.monthly</field>
            <field name="arch" type="xml">
                <list string="Comisiones Mensuales" create="0"
                      decoration-muted="state == 'paid'" decoration-info="state == 'billed'"
                      decoration-warning="state == 'closed'">
                    <field name="period"/>
                    <field name="period_label"/>
                    <field name="salesperson_id"/>
                    <field name="base_amount" sum="Base"/>
                    <field name="percentage"/>
                    <field name="commission_amount" sum="Comisión"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'paid'" decoration-info="state == 'billed'"
                           decoration-warning="state == 'closed'"/>
                    <field name="bill_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_sng_commission_monthly_form" model="ir.ui.view">
            <field name="name">sng.commission.monthly.form</field>
            <field name="model">sng.commission.monthly</field>
            <field name="arch" type="xml">
                <form string="Comisión Mensual" create="0">
                    <header>
                        <button name="action_close"
                                string="Cerrar mes"
                                type="object"
                                class="oe_highlight"
                                groups="sales_commission_omax.group_sales_commission_manager"
                                invisible="state != 'draft'"
                                confirm="Al cerrar, esta comisión ya no se recalculará y los pagos que lleguen con fecha de este mes se acumularán en el siguiente mes abierto. ¿Desea continuar?"/>
                        <button name="action_reopen"
                                string="Reabrir"
                                type="object"
                                groups="sales_commission_omax.group_sales_commission_manager"
                                invisible="state != 'closed'"
                                confirm="Al reabrir, la comisión se recalculará con los pagos vigentes. Las líneas que ya rodaron a otro mes no regresan. ¿Desea continuar?"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,closed,billed,paid"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_bill" type="object" class="oe_stat_button"
                                    icon="fa-file-text-o" invisible="not bill_id">
                                <span>Factura</span>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="salesperson_id"/>
                                <field name="period"/>
                                <field name="period_label"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="closed_date" invisible="not closed"/>
                                <field name="closed_by_id" invisible="not closed"/>
                                <field name="closed" invisible="1"/>
                            </group>
                            <group>
                                <field name="base_amount"/>
                                <field name="tier_id"/>
                                <field name="percentage"/>
                                <field name="commission_amount"/>
                                <field name="bill_id"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Detalle de Pagos" name="detail">
                                <field name="line_ids">
                                    <list create="0" delete="0" decoration-warning="is_rolled_over">
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="payment_date"/>
                                        <field name="original_period" optional="hide"/>
                                        <field name="is_rolled_over" optional="hide"/>
                                        <field name="invoice_id"/>
                                        <field name="payment_id"/>
                                        <field name="partner_id"/>
                                        <field name="payment_amount" sum="Pagado"/>
                                        <field name="tax_profile" widget="badge"
                                               decoration-success="tax_profile == 'taxed_13'"
                                               decoration-warning="tax_profile == 'mixed'"/>
                                        <field name="effective_tax_rate" optional="show"/>
                                        <field name="commission_base" sum="Base"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_sng_commission_monthly_search" model="ir.ui.view">
            <field name="name">sng.commission.monthly.search</field>
            <field name="model">sng.commission.monthly</field>
            <field name="arch" type="xml">
                <search string="Buscar comisiones mensuales">
                    <field name="salesperson_id"/>
                    <field name="period"/>
                    <filter string="Pendientes" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Cerradas" name="closed" domain="[('state', '=', 'closed')]"/>
                    <filter string="Facturadas" name="billed" domain="[('state', '=', 'billed')]"/>
                    <filter string="Pagadas" name="paid" domain="[('state', '=', 'paid')]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Vendedor" name="group_by_salesperson" context="{'group_by': 'salesperson_id'}"/>
                        <filter string="Periodo" name="group_by_period" context="{'group_by': 'period'}"/>
                        <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_sng_commission_monthly_pivot" model="ir.ui.view">
            <field name="name">sng.commission.monthly.pivot</field>
            <field name="model">sng.commission.monthly</field>
            <field name="arch" type="xml">
                <pivot string="Comisiones Mensuales">
                    <field name="salesperson_id" type="row"/>
                    <field name="period" interval="month" type="col"/>
                    <field name="commission_amount" type="measure"/>
                    <field name="base_amount" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="action_sng_commission_monthly" model="ir.actions.act_window">
            <field name="name">Comisiones Mensuales</field>
            <field name="res_model">sng.commission.monthly</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="context">{'search_default_group_by_period': 1}</field>
        </record>

        <menuitem
            id="menu_sng_commission_monthly"
            name="Comisiones mensuales"
            parent="sales_commission_omax.menu_sale_commission_root"
            action="action_sng_commission_monthly"
            sequence="10"/>
    </data>
</odoo>
