<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sng_commission_tier_tree" model="ir.ui.view">
            <field name="name">sng.commission.tier.tree</field>
            <field name="model">sng.commission.tier</field>
            <field name="arch" type="xml">
                <list string="Tramos" editable="bottom">
                    <field name="currency_id" column_invisible="1"/>
                    <field name="scheme_id" column_invisible="context.get('default_scheme_id')"/>
                    <field name="min_amount"/>
                    <field name="percentage"/>
                    <field name="active" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_sng_commission_tier_form" model="ir.ui.view">
            <field name="name">sng.commission.tier.form</field>
            <field name="model">sng.commission.tier</field>
            <field name="arch" type="xml">
                <form string="Tramo de Comisión">
                    <sheet>
                        <group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="min_amount"/>
                                <field name="percentage"/>
                            </group>
                            <group>
                                <field name="scheme_id"/>
                                <field name="active"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
