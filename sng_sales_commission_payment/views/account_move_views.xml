<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_sng_commission_exclude" model="ir.ui.view">
            <field name="name">account.move.form.sng.commission.exclude</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@id='other_tab']//group[@id='other_tab_group']" position="inside">
                    <group string="Comisión de ventas" name="sng_commission"
                           groups="sales_commission_omax.group_sales_commission_user"
                           invisible="move_type not in ('out_invoice', 'out_refund')">
                        <field name="sng_commission_exclude"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_move_search_sng_commission_exclude" model="ir.ui.view">
            <field name="name">account.move.search.sng.commission.exclude</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <filter name="late" position="after">
                    <separator/>
                    <filter name="sng_commission_excluded" string="Excluidas de comisión"
                            domain="[('sng_commission_exclude', '=', True)]"/>
                </filter>
            </field>
        </record>
    </data>
</odoo>
