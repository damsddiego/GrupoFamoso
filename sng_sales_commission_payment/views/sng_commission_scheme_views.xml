<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sng_commission_scheme_tree" model="ir.ui.view">
            <field name="name">sng.commission.scheme.tree</field>
            <field name="model">sng.commission.scheme</field>
            <field name="arch" type="xml">
                <list string="Cuadros de Comisiones">
                    <field name="name"/>
                    <field name="company_names"/>
                    <field name="date_start"/>
                    <field name="active" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_sng_commission_scheme_form" model="ir.ui.view">
            <field name="name">sng.commission.scheme.form</field>
            <field name="model">sng.commission.scheme</field>
            <field name="arch" type="xml">
                <form string="Cuadro de Comisiones">
                    <header>
                        <button name="action_regroup_open_months" type="object"
                                string="Reagrupar meses abiertos"
                                groups="sales_commission_omax.group_sales_commission_manager"
                                confirm="Las comisiones pendientes (meses sin cerrar) pasarán al cuadro que rige hoy para cada compañía: si este cuadro junta varias compañías, cada vendedor quedará con una sola comisión por mes. Los meses cerrados no cambian. ¿Continuar?"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="p. ej. Grupo Famoso"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="date_start"/>
                            </group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <div class="text-muted" colspan="2">
                            El vendedor tiene una sola comisión al mes que suma lo cobrado en todas las
                            compañías del cuadro. El tramo es el de mayor «Monto Mínimo» que no supere ese
                            acumulado sin impuestos, y su tasa se aplica sobre todo el acumulado.
                        </div>
                        <notebook>
                            <page string="Tramos" name="tiers">
                                <field name="tier_ids">
                                    <list editable="bottom">
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="min_amount"/>
                                        <field name="percentage"/>
                                        <field name="active" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_sng_commission_scheme_search" model="ir.ui.view">
            <field name="name">sng.commission.scheme.search</field>
            <field name="model">sng.commission.scheme</field>
            <field name="arch" type="xml">
                <search string="Cuadros de Comisiones">
                    <field name="name"/>
                    <field name="company_ids"/>
                    <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_sng_commission_scheme" model="ir.actions.act_window">
            <field name="name">Cuadro de Comisiones</field>
            <field name="res_model">sng.commission.scheme</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Defina un cuadro de comisiones</p>
                <p>Un cuadro tiene sus tramos y las compañías a las que aplica. Con varias compañías,
                   el vendedor tiene una sola comisión al mes que suma lo cobrado en todas.</p>
            </field>
        </record>

        <menuitem
            id="menu_sng_commission_tier"
            name="Cuadro de comisiones"
            parent="sales_commission_omax.menu_sale_commission_root"
            action="action_sng_commission_scheme"
            sequence="20"/>
    </data>
</odoo>
