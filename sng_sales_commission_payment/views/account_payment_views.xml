<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_payment_form_inherit_sng_commission" model="ir.ui.view">
            <field name="name">account.payment.form.inherit.sng.commission</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <button name="action_post" position="after">
                    <button
                        name="action_generate_commission_lines"
                        string="Generar comisiones"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'posted' or payment_type != 'inbound'"
                        confirm="Esto regenerará las líneas de comisión en borrador para este pago. ¿Desea continuar?"/>
                </button>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button
                        name="%(action_sng_commission_payment_line)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="sng_commission_count == 0">
                        <field name="sng_commission_count" widget="statinfo" string="Comisiones"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
