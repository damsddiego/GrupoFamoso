<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sng_close_commission_wiz_form" model="ir.ui.view">
            <field name="name">sng.close.commission.wiz.form</field>
            <field name="model">sng.close.commission.wiz</field>
            <field name="arch" type="xml">
                <form string="Cerrar Mes por Compañía">
                    <group>
                        <group>
                            <field name="period"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="pending_count"/>
                        </group>
                        <group>
                            <field name="uncommissioned_payment_count"/>
                            <field name="uncommissioned_pair_count"/>
                            <label for="no_salesperson_invoice_count"/>
                            <div>
                                <field name="no_salesperson_invoice_count" class="oe_inline"/>
                                <button name="action_view_no_salesperson_invoices" type="object"
                                        string="Ver facturas" class="btn btn-link oe_inline"
                                        icon="fa-external-link"
                                        invisible="not no_salesperson_invoice_count"/>
                            </div>
                            <field name="no_salesperson_invoice_ids" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not uncommissioned_payment_count">
                        Antes de cerrar se generarán automáticamente las comisiones de los
                        <strong><field name="uncommissioned_payment_count" class="oe_inline"/></strong>
                        pagos del mes que todavía no tienen línea de comisión, para que entren a este mes.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not no_salesperson_invoice_count">
                        Hay facturas cobradas en el mes sin vendedor (ni en la factura ni en el cliente):
                        no generarán comisión. Asígneles vendedor y vuelva a abrir este asistente
                        antes de cerrar, o ciérrelo sabiendo que quedarán fuera.
                    </div>
                    <div class="alert alert-warning" role="alert">
                        Se cerrarán todas las comisiones pendientes del mes seleccionado.
                        Los meses cerrados ya no se recalculan y los pagos que lleguen con
                        fecha de ese mes se acumularán en el siguiente mes abierto.
                    </div>
                    <footer>
                        <button
                            name="action_close_month"
                            string="Cerrar Mes"
                            type="object"
                            class="oe_highlight"
                            confirm="¿Confirma el cierre de todas las comisiones pendientes del mes?"/>
                        <button string="Cancelar" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sng_close_commission_wiz" model="ir.actions.act_window">
            <field name="name">Cerrar mes por compañía</field>
            <field name="res_model">sng.close.commission.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="groups_id" eval="[(4, ref('sales_commission_omax.group_sales_commission_manager'))]"/>
        </record>

        <menuitem
            id="menu_sng_close_commission_wiz"
            name="Cerrar mes por compañía"
            parent="sales_commission_omax.menu_sale_commission_root"
            action="action_sng_close_commission_wiz"
            groups="sales_commission_omax.group_sales_commission_manager"
            sequence="15"/>
    </data>
</odoo>
