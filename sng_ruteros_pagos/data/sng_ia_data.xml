<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- API key de Anthropic: reemplazar el valor en Ajustes → Técnico →
             Parámetros del sistema. Mientras conserve el valor centinela, el
             cron no hace nada (solo deja un warning en el log). -->
        <record id="config_anthropic_api_key" model="ir.config_parameter">
            <field name="key">sng_ruteros_pagos.anthropic_api_key</field>
            <field name="value">PENDIENTE_CONFIGURAR</field>
        </record>

        <record id="config_anthropic_model" model="ir.config_parameter">
            <field name="key">sng_ruteros_pagos.anthropic_model</field>
            <field name="value">claude-opus-4-8</field>
        </record>

        <record id="cron_sng_ia_matching" model="ir.cron">
            <field name="name">SNG Ruteros: matching IA de facturas</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="state">code</field>
            <field name="code">model._sng_cron_ia_matching_facturas()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
