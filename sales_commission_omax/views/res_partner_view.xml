<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="add_affiliated_partner_form" model="ir.ui.view">
            <field name="name">res.partner.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <group name="sale" position="inside">
                    <field name="affiliated" />
                    <field name="is_salesperson" />
                    <field name="assigned_salesperson_id" invisible="is_salesperson" />
                </group>
            </field>
        </record>

        <record id="add_assigned_salesperson_partner_tree" model="ir.ui.view">
            <field name="name">res.partner.tree.inherit.salesperson</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="arch" type="xml">
                <field name="complete_name" position="after">
                    <field name="assigned_salesperson_id"
                           string="Vendedor (Contacto)"
                           optional="show"/>
                </field>
            </field>
        </record>

        <record id="add_assigned_salesperson_partner_search" model="ir.ui.view">
            <field name="name">res.partner.search.inherit.salesperson</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <field name="name" position="before">
                    <field name="assigned_salesperson_id"
                           string="Vendedor (Contacto)"
                           filter_domain="[('assigned_salesperson_id.name', 'ilike', self)]"/>
                </field>
                <filter name="customer" position="after">
                    <separator/>
                    <filter string="Con vendedor"
                            name="with_assigned_salesperson"
                            domain="[('assigned_salesperson_id', '!=', False)]"/>
                    <filter string="Sin vendedor"
                            name="without_assigned_salesperson"
                            domain="[('assigned_salesperson_id', '=', False)]"/>
                </filter>
            </field>
        </record>
    </data>
</odoo>
