<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_inherit_sng_partner_receivable_account" model="ir.ui.view">
        <field name="name">res.company.form.inherit.sng.partner.receivable.account</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']/group" position="inside">
                <group string="Contabilidad clientes">
                    <field name="sng_default_receivable_account_id"/>
                    <field name="sng_default_payable_account_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
