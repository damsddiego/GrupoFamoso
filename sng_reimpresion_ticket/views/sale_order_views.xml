<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_sng_reimpresion" model="ir.ui.view">
        <field name="name">sale.order.form.sng.reimpresion</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sng_reimprimir_ticket"
                        type="object"
                        string="Reimprimir ticket"
                        groups="sng_reimpresion_ticket.group_reimpresion_ticket"
                        invisible="state not in ('sale', 'done')"/>
            </xpath>
        </field>
    </record>

</odoo>
