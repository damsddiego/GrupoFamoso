<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="view_stock_adjustment_request_tree" model="ir.ui.view">
        <field name="name">stock.adjustment.request.list</field>
        <field name="model">stock.adjustment.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de Ajuste" decoration-muted="state=='cancelled'" decoration-success="state=='approved'" decoration-danger="state=='rejected'" decoration-info="state=='submitted'">
                <field name="name" readonly="1"/>
                <field name="request_date" readonly="1"/>
                <field name="requested_by" readonly="1"/>
                <field name="approved_by" readonly="1" optional="hide"/>
                <field name="approval_date" readonly="1" optional="hide"/>
                <field name="reason" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge" readonly="1"
                    decoration-info="state=='draft'"
                    decoration-primary="state=='submitted'"
                    decoration-success="state=='approved'"
                    decoration-danger="state=='rejected'"
                    decoration-muted="state=='cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="view_stock_adjustment_request_form" model="ir.ui.view">
        <field name="name">stock.adjustment.request.form</field>
        <field name="model">stock.adjustment.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Ajuste de Inventario">
                <header>
                    <button name="action_submit" string="Enviar" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Aprobar y Aplicar" type="object"
                            class="oe_highlight" invisible="state != 'submitted'"
                            groups="stock_adjustment_approval.group_stock_adjustment_approver"/>
                    <button name="action_reject" string="Rechazar" type="object"
                            invisible="state != 'submitted'"
                            groups="stock_adjustment_approval.group_stock_adjustment_approver"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state in ('approved', 'cancelled')"/>
                    <button name="action_draft" string="Devolver a Borrador" type="object"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <button name="action_view_moves" string="Ver Movimientos" type="object"
                            class="oe_link" invisible="move_count == 0"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object" icon="fa-arrows-v"
                                class="oe_stat_button" invisible="move_count == 0">
                            <field name="move_count" widget="statinfo" string="Movimientos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="requested_by" readonly="1"/>
                            <field name="request_date" readonly="1"/>
                            <field name="approved_by" readonly="1" invisible="state in ('draft', 'submitted')"/>
                            <field name="approval_date" readonly="1" invisible="state in ('draft', 'submitted')"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="reason" readonly="state != 'draft'"/>
                            <field name="rejection_reason" readonly="1"
                                   invisible="state != 'rejected'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas de Ajuste">
                            <field name="line_ids" readonly="state in ('submitted', 'approved', 'rejected', 'cancelled')">
                                <list string="Líneas" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="location_id" options="{'no_create': True}"/>
                                    <field name="lot_id" options="{'no_create': True}"
                                           optional="show"/>
                                    <field name="package_id" options="{'no_create': True}" optional="hide"/>
                                    <field name="owner_id" options="{'no_create': True}" optional="hide"/>
                                    <field name="current_quantity" readonly="1"
                                           invisible="state != 'draft'"/>
                                    <field name="theoretical_quantity" readonly="1"
                                           invisible="state == 'draft'"
                                           string="Cantidad Teórica"/>
                                    <field name="counted_quantity"/>
                                    <field name="difference" readonly="1"/>
                                    <field name="product_uom_id" string="UdM" readonly="1" optional="show"/>
                                    <field name="applied" readonly="1" optional="hide"/>
                                </list>
                                <form string="Línea de Ajuste">
                                    <group>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="location_id"/>
                                            <field name="lot_id"/>
                                            <field name="package_id"/>
                                            <field name="owner_id"/>
                                        </group>
                                        <group>
                                            <field name="current_quantity" readonly="1"/>
                                            <field name="theoretical_quantity" readonly="1"/>
                                            <field name="counted_quantity"/>
                                            <field name="difference" readonly="1"/>
                                            <field name="product_uom_id" readonly="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Notas">
                            <field name="notes" placeholder="Notas adicionales..."
                                   readonly="state in ('approved', 'rejected', 'cancelled')"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista Búsqueda -->
    <record id="view_stock_adjustment_request_search" model="ir.ui.view">
        <field name="name">stock.adjustment.request.search</field>
        <field name="model">stock.adjustment.request</field>
        <field name="arch" type="xml">
            <search string="Solicitudes de Ajuste">
                <field name="name"/>
                <field name="requested_by"/>
                <field name="approved_by"/>
                <field name="reason"/>
                <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Enviado" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Aprobado" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rechazado" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Cancelado" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Mis Solicitudes" name="my_requests" domain="[('requested_by', '=', uid)]"/>
                <separator/>
                <filter string="Solicitudes Pendientes" name="pending" domain="[('state', '=', 'submitted')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Solicitante" name="group_by_requested_by" context="{'group_by': 'requested_by'}"/>
                    <filter string="Fecha de Solicitud" name="group_by_request_date" context="{'group_by': 'request_date:day'}"/>
                    <filter string="Compañía" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_stock_adjustment_request" model="ir.actions.act_window">
        <field name="name">Solicitudes de Ajuste de Inventario</field>
        <field name="res_model">stock.adjustment.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stock_adjustment_request_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva solicitud de ajuste de inventario
            </p>
            <p>
                Los usuarios de inventario pueden solicitar ajustes de stock.
                Los administradores de inventario los aprueban o rechazan.
            </p>
        </field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_stock_adjustment_request_root"
              name="Solicitudes de Ajuste"
              parent="stock.menu_stock_warehouse_mgmt"
              sequence="30"
              groups="stock_adjustment_approval.group_stock_adjustment_requester,stock_adjustment_approval.group_stock_adjustment_approver,stock.group_stock_manager"/>

    <menuitem id="menu_stock_adjustment_request"
              name="Todas las Solicitudes"
              parent="menu_stock_adjustment_request_root"
              action="action_stock_adjustment_request"
              sequence="10"/>
</odoo>
