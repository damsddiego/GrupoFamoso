<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Actualizar cantidad» solo para el grupo de ajuste directo: los demás
         ajustan con una solicitud. El botón «A la mano» sigue visible. -->
    <record id="product_template_form_view_procurement_button_ajuste_directo" model="ir.ui.view">
        <field name="name">product.template.actualizar.cantidad.ajuste.directo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_update_quantity_on_hand']" position="attributes">
                <attribute name="groups">stock_adjustment_approval.group_stock_ajuste_directo</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_form_view_procurement_button_ajuste_directo" model="ir.ui.view">
        <field name="name">product.product.actualizar.cantidad.ajuste.directo</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_update_quantity_on_hand']" position="attributes">
                <attribute name="groups">stock_adjustment_approval.group_stock_ajuste_directo</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_product_view_form_easy_ajuste_directo" model="ir.ui.view">
        <field name="name">product.product.easy.actualizar.cantidad.ajuste.directo</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_view_form_easy_inherit_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_update_quantity_on_hand']" position="attributes">
                <attribute name="groups">stock_adjustment_approval.group_stock_ajuste_directo</attribute>
            </xpath>
        </field>
    </record>
</odoo>
