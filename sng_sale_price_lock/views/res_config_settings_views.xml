<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sng.price.lock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pricing_setting_container']" position="inside">
                <setting id="sng_price_lock"
                         string="Bloquear precio fuera de la lista"
                         help="Impide guardar lineas de venta y factura de cliente con un precio unitario distinto al de la lista de precios">
                    <field name="sng_lock_price_unit"/>
                    <div class="content-group mt16" invisible="not sng_lock_price_unit">
                        <field name="sng_price_lock_mode" widget="radio" class="o_light_label"/>
                    </div>
                </setting>
                <setting id="sng_discount_lock"
                         string="Bloquear descuento fuera de la lista"
                         help="Impide guardar lineas de venta y factura de cliente con un descuento que la lista de precios no define">
                    <field name="sng_lock_discount"/>
                    <div class="content-group mt16" invisible="not sng_lock_discount">
                        <field name="sng_discount_lock_mode" widget="radio" class="o_light_label"/>
                    </div>
                </setting>
                <setting id="sng_price_lock_tolerance_setting"
                         string="Tolerancia del bloqueo"
                         help="Desviacion porcentual admitida antes de bloquear (0 = exacto)"
                         invisible="not sng_lock_price_unit and not sng_lock_discount">
                    <field name="sng_price_lock_tolerance" class="o_light_label"/> %
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
