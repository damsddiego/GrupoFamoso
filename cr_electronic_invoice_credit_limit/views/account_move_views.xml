<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_credit_limit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.credit.limit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Recepción de devolución, factura sustituta y factura anulada -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_stock_return" type="object"
                        class="oe_stat_button" icon="fa-truck"
                        invisible="not stock_return_picking_id">
                    <field name="stock_return_picking_id" invisible="1"/>
                    <div class="o_stat_info">
                        <span class="o_stat_text">Recepción</span>
                    </div>
                </button>
                <button name="action_sng_ver_factura_sustituta" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not sng_factura_sustituta_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Factura sustituta</span>
                    </div>
                </button>
                <button name="action_sng_ver_factura_anulada" type="object"
                        class="oe_stat_button" icon="fa-ban"
                        invisible="not sng_factura_anulada_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Factura anulada</span>
                    </div>
                </button>
            </xpath>

            <!-- Quien no puede crear notas de crédito de cliente no ve el botón
                 en las facturas de cliente; en las de proveedor no cambia. -->
            <xpath expr="//header/button[@name='action_reverse']" position="attributes">
                <attribute name="invisible">move_type not in ('out_invoice', 'in_invoice') or state != 'posted' or (move_type == 'out_invoice' and not sng_puede_crear_nc)</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_sng_crear_factura_sustituta" type="object"
                        string="Crear factura sustituta"
                        invisible="not sng_puede_crear_sustituta"
                        groups="account.group_account_invoice"/>
            </xpath>

            <!-- La nota de crédito hecha desde la factura no mueve inventario:
                 la ubicación solo se muestra en las que ya la traen. -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="has_stock_delivery" invisible="1"/>
                <field name="sng_puede_crear_sustituta" invisible="1"/>
                <field name="sng_puede_crear_nc" invisible="1"/>
                <field name="sng_motivo_anulacion_id"
                       invisible="move_type != 'out_refund'"
                       readonly="state != 'draft'"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="return_location_id"
                       invisible="not return_location_id"
                       options="{'no_open': True}"/>
                <field name="sng_factura_sustituta_id"
                       invisible="not sng_factura_sustituta_id"/>
                <field name="sng_factura_anulada_id"
                       invisible="not sng_factura_anulada_id"/>
            </xpath>

            <!-- Add the credit note total field after tax totals -->
            <xpath expr="//field[@name='tax_totals']" position="after">
                <field name="credit_note_total"
                       invisible="move_type != 'out_refund'"
                       readonly="1"
                       widget="monetary"/>
            </xpath>

            <!-- Also add it to the l10n_cr view if it exists -->
            <xpath expr="//field[@name='amount_total_electronic_invoice']" position="after">
                <field name="credit_note_total"
                       invisible="move_type != 'out_refund'"
                       readonly="1"
                       widget="monetary"/>
            </xpath>
        </field>
    </record>

    <!-- Add remaining quantity field to invoice lines -->
    <record id="view_move_form_inherit_credit_limit_lines" model="ir.ui.view">
        <field name="name">account.move.form.inherit.credit.limit.lines</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add remaining_qty_to_refund field in invoice lines tree view -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='quantity']" position="after">
                <field name="remaining_qty_to_refund"
                       string="Available to Refund"
                       optional="show"
                       invisible="parent.move_type != 'out_invoice'"
                       readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>