<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="motivo_anulacion_descuento" model="sng.motivo.anulacion">
        <field name="name">Error de descuento</field>
        <field name="sequence">10</field>
    </record>
    <record id="motivo_anulacion_precio" model="sng.motivo.anulacion">
        <field name="name">Error de precio</field>
        <field name="sequence">20</field>
    </record>
    <record id="motivo_anulacion_producto" model="sng.motivo.anulacion">
        <field name="name">Código o producto incorrecto</field>
        <field name="sequence">30</field>
    </record>
    <record id="motivo_anulacion_condicion" model="sng.motivo.anulacion">
        <field name="name">Condición de venta incorrecta</field>
        <field name="sequence">40</field>
    </record>
    <record id="motivo_anulacion_cliente" model="sng.motivo.anulacion">
        <field name="name">Cliente o datos del cliente incorrectos</field>
        <field name="sequence">50</field>
    </record>
    <record id="motivo_anulacion_repetida" model="sng.motivo.anulacion">
        <field name="name">Factura repetida</field>
        <field name="requiere_refactura" eval="False"/>
        <field name="sequence">60</field>
    </record>
    <record id="motivo_anulacion_no_solicitado" model="sng.motivo.anulacion">
        <field name="name">Cliente no lo solicitó</field>
        <field name="requiere_refactura" eval="False"/>
        <field name="sequence">70</field>
    </record>
    <record id="motivo_anulacion_hacienda" model="sng.motivo.anulacion">
        <field name="name">Rechazada por Hacienda</field>
        <field name="sequence">80</field>
    </record>
    <record id="motivo_anulacion_sin_inventario" model="sng.motivo.anulacion">
        <field name="name">Sin inventario</field>
        <field name="requiere_refactura" eval="False"/>
        <field name="sequence">90</field>
    </record>
    <record id="motivo_anulacion_otro" model="sng.motivo.anulacion">
        <field name="name">Otro</field>
        <field name="sequence">100</field>
    </record>
</odoo>
