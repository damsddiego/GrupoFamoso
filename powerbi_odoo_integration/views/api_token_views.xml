<odoo>
    <record id="view_powerbi_api_token_tree" model="ir.ui.view">
        <field name="name">powerbi.api.token.tree</field>
        <field name="model">powerbi.api.token</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>


   <record id="view_powerbi_api_token_form" model="ir.ui.view">
    <field name="name">powerbi.api.token.form</field>
    <field name="model">powerbi.api.token</field>
    <field name="arch" type="xml">
        <form string="API Access Token">
            <sheet>
                <header>
                <button name="action_generate_token"
                                string="Generate Token"
                                type="object"
                                class="btn-success"
                                icon="fa-refresh"
                                modifiers="{'visible': 'not id'}"/>
                </header>
                <h1>
                    <field name="user_id"/>
                </h1>
                <group>
                    <group>
                        <field name="name"
                               readonly="1"
                               placeholder="No token generated yet"/>
                        <!-- "Generate" button, only visible on NEW records -->

                    </group>
                    <group>
                        <field name="active"/>
                    </group>
                </group>
            </sheet>
        </form>
    </field>
</record>



