<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sng_comercial_sell_wizard_form" model="ir.ui.view">
        <field name="name">sng.comercial.sell.wizard.form</field>
        <field name="model">sng.comercial.sell.wizard</field>
        <field name="arch" type="xml">
            <form string="Descargar Sell in / Sell out">
                <p class="text-muted">
                    Compras recibidas (sell in) y ventas facturadas (sell out) de los productos con pilar,
                    en unidades y litros, con el inventario al momento de la descarga.
                </p>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_descargar_excel" type="object" string="Descargar Excel" class="btn-primary"/>
                    <button name="action_ver_analisis" type="object" string="Ver análisis" class="btn-secondary"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sng_comercial_sell_wizard" model="ir.actions.act_window">
        <field name="name">Descargar Sell in / Sell out</field>
        <field name="res_model">sng.comercial.sell.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
